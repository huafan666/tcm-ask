# 中医辨证助手 - 环境配置
# 把下面这行的 <你的Key> 换成你的 DeepSeek API 密钥（没有也没关系，可先用"规则辨证"模式）
# 获取 key：https://platform.deepseek.com
#
# 注意：这一段只影响「命令行版 run-mvp.js」和「独立 server.js」。
# 云平台（platform/）里每个账号在「设置」页配自己的 key，彼此独立；
# 想让平台也给没配 key 的账号兜底，启动时加环境变量 PLATFORM_ALLOW_ENV_LLM=1。

LLM_KEY=

# 下面通常不用改
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
